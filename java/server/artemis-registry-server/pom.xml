<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.mydotey.ai.artemis</groupId>
    <artifactId>artemis-server-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>artemis-registry-server</artifactId>
  <description>registry 服务端 Spring Boot 装配：gRPC 接入层 + 端口注入（phase-4 递补 HTTP/认证/指标）</description>

  <dependencyManagement>
    <dependencies>
      <!-- server 测试线随 SB 4.1 原生 JUnit 6（SpringExtension 依赖 6 的 Store API）；
           全局默认 JUnit 5（Java 8 兼容线，client/starter/core） -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit-server.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.mydotey.ai.artemis</groupId>
      <artifactId>artemis-registry-core</artifactId>
    </dependency>
    <dependency>
      <!-- 测试设施复用（MutableClock 等）-->
      <groupId>org.mydotey.ai.artemis</groupId>
      <artifactId>artemis-registry-core</artifactId>
      <version>${revision}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!-- HTTP 辅助通道（外部端口）+ 内部管理端口 actuator -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <!-- trace：Spring Boot 4.1 官方 OpenTelemetry 集成 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-opentelemetry</artifactId>
    </dependency>
    <!-- 结构化 JSON 日志 -->
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
    </dependency>
    <!-- SCF source/manager 装配（properties 定义在 registry-core infrastructure） -->
    <dependency>
      <groupId>org.mydotey.scf</groupId>
      <artifactId>scf-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.mydotey.scf</groupId>
      <artifactId>scf-simple</artifactId>
    </dependency>
    <!-- Spring Boot 4.1 官方 gRPC 服务端（tech-stack #33）：@GrpcService 自动装配，
         端口/传输/生命周期由 starter 管理，不自写 Server；版本随 SB BOM -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-grpc-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- IT 支持：随机端口注解与 in-process 传输（spring.grpc.server.port=0 + @LocalGrpcServerPort） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-grpc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- SDK 端到端 IT：ClientSdkIT 以 artemis-client 驱动真服务端（反向依赖不违 enforcer——
         边界纪律只禁 client 依赖服务端模块；SDK 版本走独立字面版本线） -->
    <dependency>
      <groupId>org.mydotey.ai.artemis</groupId>
      <artifactId>artemis-client</artifactId>
      <version>0.1.0-SNAPSHOT</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 可执行 fat jar（单节点起停/容器化基础）。classifier=exec：原 jar 保持普通布局，
           failsafe/测试 classpath 不受 BOOT-INF 重排影响 -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <configuration>
          <classifier>exec</classifier>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- failsafe 正式绑定（phase-2 起）：*IT 服务级集成测试进 verify 生命周期，
           dev-test.sh integration|all 模式经此覆盖 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- 测试 JVM 全局关停机排水：各 IT tearDown 的 context close 不等待 drain；
                 需要排水的用例（GracefulShutdownIT）以节点启动参数显式覆盖（命令行优先级更高） -->
            <artemis.registry.shutdown.drainMs>0</artemis.registry.shutdown.drainMs>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- 同上：*Test 中起 Spring context 的用例（如 ApplicationContextTest）close 不等待 drain -->
            <artemis.registry.shutdown.drainMs>0</artemis.registry.shutdown.drainMs>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
