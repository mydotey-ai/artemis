<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.mydotey.ai.artemis</groupId>
    <artifactId>artemis-server-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>artemis-common</artifactId>
  <description>服务端公共规范/工具；proto 生成 common.v1、projection.v1 与 management.v1（服务端共享，各 core 经 Maven 依赖引用）</description>

  <dependencies>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
    </dependency>
    <!-- management.v1 含 registry 只读查询 service（registry 实现 / management 调用），stub 生成编译依赖 -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
    </dependency>
    <!-- TLS 装配（common.tls）：GrpcSslContexts/NettyChannelBuilder 所在（组件总表 #8 服务端 grpc-netty） -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty</artifactId>
    </dependency>
    <!-- 静态配置项通用工具（各使用类传入自己的键/默认值/范围） -->
    <dependency>
      <groupId>org.mydotey.scf</groupId>
      <artifactId>scf-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.mydotey.scf</groupId>
      <artifactId>scf-simple</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.github.ascopes</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
        <configuration>
          <protoc>${protobuf.version}</protoc>
          <includes>
            <include>common/v1/*.proto</include>
            <include>projection/v1/*.proto</include>
            <include>management/v1/*.proto</include>
          </includes>
          <plugins>
            <plugin kind="binary-maven">
              <groupId>io.grpc</groupId>
              <artifactId>protoc-gen-grpc-java</artifactId>
              <version>${grpc.version}</version>
            </plugin>
          </plugins>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>generate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- 测试证书设施 test-jar（TestCertificates，keytool 自签 + PEM 导出）供各 server IT 复用 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-test-jar</id>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
