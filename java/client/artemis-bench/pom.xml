<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.mydotey.ai.artemis</groupId>
    <artifactId>artemis-client-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>artemis-bench</artifactId>
  <description>容量压测 driver（v1.0 phase-6）：SDK 驱动的负载生成与采样。依赖封闭同 SDK 线（artemis-client + slf4j + micrometer），不依赖服务端模块；编排与预检在 java/scripts/bench.sh（服务端用各 *-server exec jar 拉起）。</description>

  <dependencies>
    <dependency>
      <groupId>org.mydotey.ai.artemis</groupId>
      <artifactId>artemis-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- driver 可执行 fat jar：bench.sh 经 java -jar 起分片/subscriber/join -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.mydotey.ai.artemis.bench.BenchDriver</mainClass>
                </transformer>
                <!-- grpc/netty 经 META-INF/services 注册 SPI（NameResolverProvider 等），shade 不合并会覆盖丢失 → dns 解析缺位、target 误入 unix 解析 -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
