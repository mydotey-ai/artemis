<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.mydotey.ai.artemis</groupId>
    <artifactId>artemis-client-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>artemis-client</artifactId>
  <description>注册 + 发现统一 SDK，Java 8 目标、零 Spring；自生成 common.v1/registry.v1/discovery.v1（protoc 3.25.x）</description>

  <dependencies>
    <!-- SDK 运行时依赖封闭清单（技术选型 #30/#31），新增组件须先进组件总表 -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty-shaded</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.mydotey.scf</groupId>
      <artifactId>scf-simple</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <!-- SDK 可观测标准端口（技术选型 #34）：注入或 globalRegistry，宿主不配则空转 -->
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>

    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.github.ascopes</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
        <configuration>
          <protoc>${protobuf-client.version}</protoc>
          <includes>
            <include>common/v1/*.proto</include>
            <include>registry/v1/*.proto</include>
            <include>discovery/v1/*.proto</include>
          </includes>
          <plugins>
            <plugin kind="binary-maven">
              <groupId>io.grpc</groupId>
              <artifactId>protoc-gen-grpc-java</artifactId>
              <version>${grpc.version}</version>
            </plugin>
          </plugins>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>generate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- surefire（JDK 8 toolchain fork）与 SDK 边界 enforcer 均在 artemis-client-parent 统一配置 -->
    </plugins>
  </build>
</project>
